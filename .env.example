# Copie ce fichier en ".env" et remplis les valeurs.
# Elles se trouvent dans Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://TON-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=ta-cle-anon-publique

# Push / contacts scaffolds — keep false until secrets + native OK (see PERMISSIONS_AND_CONTACTS.md)
VITE_PUSH_ENABLED=false
VITE_CONTACTS_MATCH_ENABLED=false

# Analytics — consent-aware, pluggable sink; keep false until privacy OK + tool chosen
VITE_ANALYTICS_ENABLED=false

# Google OAuth Client ID/Secret are NOT Vite env vars.
# Enable them only in Supabase Dashboard → Auth → Providers → Google.
# See docs/GOOGLE_OAUTH_AUTH_URLS.md
